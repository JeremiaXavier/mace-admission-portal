#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# Update this to your actual domain or server IP
app.baseURL = 'http://localhost/'
app.sessionDriver = 'CodeIgniter\Session\Handlers\FileSessionHandler'
app.sessionCookieName = 'ci_session'
app.sessionExpiration = 7200
app.sessionSavePath = WRITEPATH . 'session'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = db
database.default.database = mace_admission
database.default.username = mace_user
database.default.password = mace_password
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# SECURITY
#--------------------------------------------------------------------
# Uncomment and set a strong, random encryption key
# app.encryptionKey = 'your-32-char-random-string-here'
